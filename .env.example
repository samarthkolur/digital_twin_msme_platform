# Docker Compose variable substitution (non-secret). Copied to `.env` by
# scripts/bootstrap.sh — `.env` itself is gitignored.
#
# Actual secrets (ANTHROPIC_API_KEY / OPENAI_API_KEY for the copilot's
# optional API fallback) are NEVER stored here or anywhere in this repo.
# They live in an external file outside the working tree, referenced below.

# Which sensor provider the edge service uses in dev (see services/edge).
# Real Raspberry Pi deployments set this via docker-compose.prod.yml instead.
SENSOR_PROVIDER=simulated

# Identifier for the pilot machine being monitored (design.md §6.0 state model).
# Used as the MQTT topic segment and the SQLite raw_readings.asset_id column.
ASSET_ID=motor_01

# local = TinyLlama via llama.cpp (no secrets needed); api = Anthropic/OpenAI fallback.
COPILOT_LLM_MODE=local

# Absolute path to an env-file holding copilot API-fallback secrets, OUTSIDE
# this repository. scripts/bootstrap.sh creates this file (with placeholder
# keys) on first run if it doesn't exist yet, and validates it's present on
# every run. Default location: $HOME/.config/digital-cousin/secrets.env
SECRETS_FILE=/home/CHANGE_ME/.config/digital-cousin/secrets.env
